import { NextResponse } from 'next/server';
import type { NextRequest } from 'next/server';
import { jwtVerify } from 'jose';

const adminSecret = new TextEncoder().encode(process.env.JWT_SECRET || 'fallback-secret-change-me-in-env');
const customerSecret = new TextEncoder().encode(process.env.CUSTOMER_JWT_SECRET || process.env.JWT_SECRET || 'customer-fallback-secret-change-me');

export async function proxy(request: NextRequest) {
  const { pathname } = request.nextUrl;

  // ⚡️ THE ULTIMATE FIX: If it's the Enamad file, bypass everything
  if (pathname === '/36668862.txt') {
    return NextResponse.next();
  }

  // ... (بقیه کدهای ادمین و اکانت بدون تغییر) ...
  if (pathname.startsWith('/admin')) {
    const token = request.cookies.get('admin_token')?.value;
    if (pathname !== '/admin/login') {
      if (!token) return NextResponse.redirect(new URL('/admin/login', request.url));
      try { await jwtVerify(token, adminSecret); } catch { return NextResponse.redirect(new URL('/admin/login', request.url)); }
    } else if (token) {
      try { await jwtVerify(token, adminSecret); return NextResponse.redirect(new URL('/admin', request.url)); } catch {}
    }
    return NextResponse.next();
  }

  if (pathname.startsWith('/account')) {
    const isAuthRoute = pathname === '/account/login' || pathname === '/account/register';
    const token = request.cookies.get('customer_token')?.value;
    if (isAuthRoute) {
      if (token) {
        try {
          const { payload } = await jwtVerify(token, customerSecret);
          const isTemp = (payload.email as string)?.endsWith('@temp.fatemehlab.ir');
          return NextResponse.redirect(new URL(isTemp ? '/account/onboarding' : '/account', request.url));
        } catch {}
      }
      return NextResponse.next();
    }
    if (!token) return NextResponse.redirect(new URL(`/account/login?redirect=${pathname}`, request.url));
    try {
      const { payload } = await jwtVerify(token, customerSecret);
      const email = (payload.email as string) || '';
      const isTemp = email.endsWith('@temp.fatemehlab.ir');
      const isOnboardingRoute = pathname === '/account/onboarding';
      if (isTemp && !isOnboardingRoute) return NextResponse.redirect(new URL('/account/onboarding', request.url));
      if (!isTemp && isOnboardingRoute) return NextResponse.redirect(new URL('/account', request.url));
    } catch {
      const response = NextResponse.redirect(new URL('/account/login', request.url));
      response.cookies.delete('customer_token');
      return response;
    }
  }
  return NextResponse.next();
}

// ⚡️ Matcher should be empty or very specific to not block the route handler
export const config = {
  matcher: [
    /*
     * Match all paths except for:
     * 1. /api routes
     * 2. /_next (Next.js internals)
     * 3. /36668862.txt (our specific Enamad file)
     * 4. all root files inside /public (e.g. /favicon.ico)
     */
    '/((?!api|_next/static|_next/image|36668862\\.txt|favicon.ico).*)',
  ],
};